{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "~/*": ["./*"] }
  },
  "include": [
    "src/models/ionosphere/**/*.ts",
    "src/utils/ionosphere/**/*.ts",
    "src/cesium/**/*.ts",
    "src/services/ionosphere/**/*.ts",
    "src/store/ionosphere/**/*.ts"
  ]
}
